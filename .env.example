# ==============================================================================
# Personal Expense Tracker - Environment Configuration Template
# Copy this file to .env and adjust credentials for your environment
# ==============================================================================

# Application Settings
APP_NAME="Personal Expense Tracker"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/Personal_Expense_Tracker

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=personal_expense_tracker
DB_USER=root
DB_PASS=root

# Outgoing Mail / SMTP Configuration
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
FROM_EMAIL=no-reply@expense.com
FROM_NAME="Personal Expense Tracker"
